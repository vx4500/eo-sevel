[Unit]
Description=Mise à jour contrôlée de EO_Sevel depuis GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=EO_UPDATE_MODE=github
Environment=CARGO_INCREMENTAL=0
# La compilation partage le conteneur avec l'élevage : mémoire bornée,
# priorité basse.
MemoryMax=3G
Nice=15
IOSchedulingClass=idle
ExecStart=/opt/eo-sevel-src/scripts/mettre-a-jour-zip.sh
# En cas d'échec, la demande est retirée pour ne pas relancer en boucle.
ExecStopPost=/usr/bin/rm -f /var/lib/eo-sevel/mise-a-jour-demandee
