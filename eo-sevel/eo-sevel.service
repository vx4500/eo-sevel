[Unit]
Description=EO_Sevel Rust
After=network.target

[Service]
Type=simple
User=eo-sevel
WorkingDirectory=/opt/eo-sevel
Environment=ELEVAGE_DATA=/var/lib/eo-sevel
Environment=EO_HOST=0.0.0.0
Environment=EO_PORT=8080
Environment=EO_SECURE_COOKIES=true
ExecStart=/opt/eo-sevel/eo-sevel
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/eo-sevel

[Install]
WantedBy=multi-user.target
